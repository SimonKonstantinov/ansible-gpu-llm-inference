services:
  vllm:
    image: {{ vllm_image }}
    container_name: vllm
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ vllm_port }}:8000"
    volumes:
      - vllm_cache:/root/.cache
    gpus: all
    command: >
      --model {{ vllm_model }}
      --host 0.0.0.0
      --port 8000

volumes:
  vllm_cache:
