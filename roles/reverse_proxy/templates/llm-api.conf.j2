server {
    listen {{ reverse_proxy_listen_port }};
    server_name _;

    location / {
        if ($http_authorization != "Bearer {{ reverse_proxy_api_token }}") {
            return 401;
        }
{% if llm_runtime == 'vllm' %}
        proxy_pass http://127.0.0.1:{{ vllm_port }};
{% else %}
        proxy_pass http://{{ ollama_listen_host }}:{{ ollama_listen_port }};
{% endif %}
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
