server {
    listen {{ reverse_proxy_listen_port }};
    server_name _;

    location / {
        if ($http_authorization != "Bearer {{ reverse_proxy_api_token }}") {
            return 401;
        }
        proxy_pass http://{{ ollama_listen_host }}:{{ ollama_listen_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }
}
