services:
  node_exporter:
    image: prom/node-exporter:latest
    container_name: node_exporter
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ node_exporter_port }}:9100"
    pid: host
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    command:
      - --path.procfs=/host/proc
      - --path.sysfs=/host/sys
      - --path.rootfs=/rootfs
      - --collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)

{% if monitoring_enable_cadvisor | bool %}
  cadvisor:
    image: {{ cadvisor_image }}
    container_name: cadvisor
    restart: unless-stopped
{% if cadvisor_extra_args is defined and cadvisor_extra_args | length > 0 %}
    command: {{ cadvisor_extra_args }}
{% endif %}
    ports:
      - "127.0.0.1:{{ cadvisor_port }}:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    privileged: true
    devices:
      - /dev/kmsg
{% endif %}

{% if llm_runtime == 'ollama' and monitoring_enable_ollama_exporter | default(true) | bool %}
  ollama-exporter:
    image: {{ ollama_exporter_image }}
    container_name: ollama_exporter
    restart: unless-stopped
    environment:
      OLLAMA_URL: "{{ ollama_exporter_url }}"
    ports:
      - "127.0.0.1:{{ ollama_exporter_port }}:9400"
{% endif %}

{% if monitoring_enable_nginx_exporter | bool and enable_reverse_proxy | bool %}
  nginx-exporter:
    image: {{ nginx_exporter_image }}
    container_name: nginx_exporter
    restart: unless-stopped
    command:
      - --nginx.scrape-uri={{ nginx_stub_status_uri }}
    ports:
      - "127.0.0.1:{{ nginx_exporter_port }}:9113"
{% endif %}

  dcgm-exporter:
    image: {{ dcgm_exporter_image }}
    container_name: dcgm_exporter
    restart: unless-stopped
    runtime: nvidia
    environment:
      NVIDIA_VISIBLE_DEVICES: all
    cap_add:
      - SYS_ADMIN
    ports:
      - "127.0.0.1:{{ dcgm_exporter_port }}:9400"

  prometheus:
    image: {{ prometheus_image }}
    container_name: prometheus
    restart: unless-stopped
    depends_on:
      - node_exporter
      - dcgm-exporter
    ports:
      - "127.0.0.1:{{ prometheus_port }}:9090"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./data/prometheus:/var/lib/prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/var/lib/prometheus
      - --web.enable-lifecycle

  grafana:
    image: {{ grafana_image }}
    container_name: grafana
    restart: unless-stopped
    depends_on:
      - prometheus
    ports:
      - "127.0.0.1:{{ grafana_port }}:3000"
    environment:
      GF_SECURITY_ADMIN_USER: "{{ grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_SERVER_ROOT_URL: "%(protocol)s://%(domain)s:%(http_port)s/"
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro

volumes:
  grafana_data:
