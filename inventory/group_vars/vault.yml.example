---
# Создайте зашифрованный vault.yml:
#   ansible-vault create inventory/group_vars/gpu_llm/vault.yml
# Подключение в group_vars/gpu_llm/vars.yml:
#   reverse_proxy_api_token: "{{ vault_reverse_proxy_api_token }}"
#   grafana_admin_password: "{{ vault_grafana_admin_password }}"
#   grafana_nginx_password: "{{ vault_grafana_nginx_password }}"

vault_reverse_proxy_api_token: "REPLACE_WITH_STRONG_TOKEN"
vault_grafana_admin_password: "REPLACE_WITH_STRONG_PASSWORD"
vault_grafana_nginx_password: "REPLACE_WITH_STRONG_PASSWORD"
vault_open_webui_nginx_password: "REPLACE_WITH_STRONG_PASSWORD"
